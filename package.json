{
  "name": "wharf-hotel",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "test": "npm test -w backend",
    "db:migrate": "npm run migrate -w backend",
    "db:demo": "npm run seed -w backend",
    "admin:create": "npm run admin:create -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
